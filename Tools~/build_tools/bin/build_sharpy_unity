#!/usr/bin/env python3
"""Sharpy Unity build system entry point.

This is the chiri build system script. Invoke via:
    build_sharpy_unity <command> [options]

Or via Python module, from the repo root:
    PYTHONPATH=Tools~ python3 -m build_tools <command> [options]

Commands:
    format           Format C# files per .editorconfig conventions
    bundle-core      Build Sharpy.Core (netstandard2.1) and copy DLLs to Plugins/
    bundle-compiler  Publish self-contained sharpyc binaries for each platform
    bundle-all       Bundle both Sharpy.Core and sharpyc compiler
    smoke-compile    Compile the package's assemblies against Unity DLLs (no license)
    check-metas      Check every imported asset has a tracked .meta, none orphaned
    update-toolchain Re-pin to a sharpy release (version pin + Plugins DLLs)
    clean            Remove temporary build artifacts
    info             Show package and environment info
"""

import os
import sys

# Ensure Tools~ (the parent of the build_tools package) is on the Python path
# so build_tools is importable
tools_root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0, tools_root)

from build_tools.cli import main

if __name__ == "__main__":
    main()
else:
    main()
