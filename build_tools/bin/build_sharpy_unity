#!/usr/bin/env python3
"""Sharpy Unity build system entry point.

This is the chiri build system script. Invoke via:
    build_sharpy_unity <command> [options]

Or via Python module:
    python -m build_tools <command> [options]

Commands:
    format           Format C# files per .editorconfig conventions
    bundle-core      Build Sharpy.Core (netstandard2.1) and copy DLLs to Plugins/
    bundle-compiler  Publish self-contained sharpyc binaries for each platform
    bundle-all       Bundle both Sharpy.Core and sharpyc compiler
    clean            Remove temporary build artifacts
    info             Show package and environment info
"""

import os
import sys

# Ensure the repo root is on the Python path so build_tools is importable
repo_root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0, repo_root)

from build_tools.cli import main

if __name__ == "__main__":
    main()
else:
    main()
