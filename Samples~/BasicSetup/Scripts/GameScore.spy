class GameScore:
    """Tracks a player's score with add, reset, and query operations."""

    player_name: str
    score: int
    high_score: int

    def __init__(self, player_name: str):
        self.player_name = player_name
        self.score = 0
        self.high_score = 0

    def add_points(self, points: int) -> None:
        """Add points to the current score and update the high score."""
        self.score = self.score + points
        if self.score > self.high_score:
            self.high_score = self.score

    def reset(self) -> None:
        """Reset the current score to zero. The high score is preserved."""
        self.score = 0

    def get_score(self) -> int:
        """Return the current score."""
        return self.score

    def get_high_score(self) -> int:
        """Return the highest score achieved."""
        return self.high_score

    def get_player_name(self) -> str:
        """Return the player name."""
        return self.player_name
