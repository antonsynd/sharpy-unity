"""Plain Sharpy module with no Unity dependency, imported by behaviours."""


def greet(name: str) -> str:
    """Return a greeting for the given name."""
    return "Hello from Sharpy, " + name + "!"


def wrap_degrees(angle: float32) -> float32:
    """Wrap an angle in degrees into [0, 360). Unity uses float32 (C# float)."""
    return angle % 360.0f
